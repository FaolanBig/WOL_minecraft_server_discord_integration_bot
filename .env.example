# Create a Discord application and bot at https://discord.com/developers/applications.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_APPLICATION_ID=replace-with-application-id
DISCORD_GUILD_ID=replace-with-discord-server-id
DISCORD_ALLOWED_ROLE_IDS=replace-with-role-id

# The Minecraft server's wired network adapter MAC address and LAN broadcast destination.
WOL_MAC=00:11:22:33:44:55
WOL_BROADCAST=255.255.255.255
WOL_PORT=9

# RCON must be enabled on the Minecraft Java server and reachable from this Docker host.
MINECRAFT_RCON_ADDRESS=192.168.1.50:25575
MINECRAFT_RCON_PASSWORD=replace-with-a-long-random-password

# Dedicated SSH identity and pinned host keys for the Linux Minecraft host.
HOST_SSH_ADDRESS=192.168.1.50:22
HOST_SSH_USER=minecraft-bot
HOST_SSH_KEY_FILE=/run/secrets/minecraft_bot_ed25519
HOST_SSH_KNOWN_HOSTS_FILE=/run/secrets/known_hosts

# Maximum time /start waits for the host and Minecraft to become available.
STARTUP_TIMEOUT=5m
