#!/bin/sh
set -eu

case "${SSH_ORIGINAL_COMMAND:-}" in
    start-minecraft|schedule-shutdown|cancel-shutdown)
        exec /usr/bin/sudo -n /usr/local/sbin/minecraft-discord-control-root "$SSH_ORIGINAL_COMMAND"
        ;;
    *)
        echo "Unsupported host-control request" >&2
        exit 64
        ;;
esac
