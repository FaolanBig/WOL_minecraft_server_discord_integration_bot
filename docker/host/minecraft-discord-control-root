#!/bin/sh
set -eu

CONFIG=/etc/default/minecraft-discord-bot
if [ ! -r "$CONFIG" ]; then
    echo "Missing $CONFIG" >&2
    exit 1
fi
. "$CONFIG"

case "${MINECRAFT_SYSTEMD_UNIT:-}" in
    ""|*[!A-Za-z0-9_.@:-]*)
        echo "Invalid MINECRAFT_SYSTEMD_UNIT" >&2
        exit 1
        ;;
esac

case "${1:-}" in
    start-minecraft)
        /usr/bin/systemctl stop minecraft-host-shutdown.timer minecraft-host-shutdown.service
        exec /usr/bin/systemctl start "$MINECRAFT_SYSTEMD_UNIT"
        ;;
    schedule-shutdown)
        if ! /usr/bin/systemctl is-active --quiet minecraft-host-shutdown.timer; then
            exec /usr/bin/systemctl start minecraft-host-shutdown.timer
        fi
        ;;
    cancel-shutdown)
        exec /usr/bin/systemctl stop minecraft-host-shutdown.timer minecraft-host-shutdown.service
        ;;
    *)
        echo "Unsupported host-control request" >&2
        exit 64
        ;;
esac
